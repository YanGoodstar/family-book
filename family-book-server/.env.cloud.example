# 微信云托管测试环境变量示例
# 请在云托管控制台按环境分别配置

SERVER_PORT=9000
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m -Djava.security.egd=file:/dev/./urandom

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-mysql-username
DB_PASSWORD=your-mysql-password

JWT_SECRET=replace-with-a-strong-random-secret

WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

XXL_JOB_ADMIN=http://localhost:8080/xxl-job-admin
XXL_JOB_TOKEN=

# 当前版本未使用 Redis。
# 如果后续新增缓存、验证码、限流或 token 黑名单，再补 Redis 环境变量。
