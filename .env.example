# 家庭记账小程序 - 环境变量示例
# 复制此文件为 .env 后再填写真实值

# 数据库配置
DB_ROOT_PASSWORD=your_mysql_root_password
DB_USERNAME=familybook
DB_PASSWORD=your_mysql_password

# JWT 密钥
# 可用 openssl rand -base64 32 生成
JWT_SECRET=your_jwt_secret_key_here

# 微信小程序配置
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret

# XXL-Job，可选
XXL_JOB_ADMIN=http://localhost:8080/xxl-job-admin
XXL_JOB_TOKEN=

# 域名配置，用于 SSL 证书
DOMAIN=your-domain.com

# 当前版本未使用 Redis。
# 如果后续增加缓存、验证码、限流或 token 黑名单，再补充 Redis 配置即可。
